import "./styles.scss";
import type { Customization, YMap, YMapEntity } from "ymaps3";

// Get Yandex API Key from environment variables (loaded via dotenv-webpack)
const YANDEX_API_KEY = process.env.YANDEX_API_KEY;

// Log key status for debugging (masking for security)
if (YANDEX_API_KEY) {
    console.log(
        `Yandex API Key loaded successfully: ${YANDEX_API_KEY.substring(0, 5)}...`,
    );
} else {
    console.warn(
        "Yandex API Key is missing! Please configure YANDEX_API_KEY in your .env file.",
    );
    showKeyError();
}

/**
 * Show visual error feedback to the user if API Key is missing.
 */
function showKeyError(): void {
    const loaderSubtitle = document.querySelector(".loader-subtitle");
    const spinner = document.querySelector(".premium-spinner");
    if (loaderSubtitle) {
        loaderSubtitle.textContent =
            "შეცდომა: YANDEX_API_KEY ვერ მოიძებნა .env ფაილში.";
        (loaderSubtitle as HTMLElement).style.color = "#ff453a";
    }
    if (spinner) {
        (spinner as HTMLElement).style.borderTopColor = "#ff453a";
        (spinner as HTMLElement).style.borderRightColor = "#ff453a";
        (spinner as HTMLElement).style.boxShadow =
            "0 0 25px rgba(255, 69, 58, 0.4)";
    }
}

/**
 * Dynamically loads the Yandex Maps API v3 script.
 */
function loadYandexMaps(apiKey: string): Promise<void> {
    return new Promise((resolve, reject) => {
        if (typeof ymaps3 !== "undefined") {
            resolve();
            return;
        }

        const script = document.createElement("script");
        // Loading v3 of Yandex Maps API using the key and English locale with metric system (en_RU)
        script.src = `https://api-maps.yandex.ru/v3/?apikey=${apiKey}&lang=ru_RU`;
        script.async = true;
        script.onload = () => {
            const ymaps = (
                window as unknown as { ymaps3: typeof import("ymaps3") }
            ).ymaps3;
            ymaps.ready.then(resolve).catch(reject);
        };
        script.onerror = (err) => reject(err);
        document.head.appendChild(script);
    });
}

/**
 * Initializes the Yandex Map.
 */
async function initializeMap(): Promise<void> {
    if (!YANDEX_API_KEY) return;

    try {
        await loadYandexMaps(YANDEX_API_KEY);

        // Core modules from the ymaps3 global
        const {
            YMap,
            YMapDefaultSchemeLayer,
            YMapDefaultFeaturesLayer,
            YMapControls,
            YMapListener,
        } = ymaps3;

        // Customization schema to make the map look white/light-grayscale
        // and hide unimportant points of interest (POIs)
        const whiteSchemeCustomization: Customization = [
            // 1. Hide all Points of Interest (POIs) - businesses, shops, cafes, etc.
            {
                tags: { any: ["poi"] },
                stylers: [{ opacity: 0 }],
            },
            // 2. Make landscape and general ground clean white/light gray
            {
                tags: { any: ["landscape", "admin", "land", "ground"] },
                elements: "geometry",
                stylers: [{ color: "#fcfcfc" }],
            },
            // 3. Make water bodies light blue-gray
            {
                tags: { any: ["water"] },
                elements: "geometry",
                stylers: [{ color: "#e3ecef" }],
            },
            // 4. Style buildings to be clean off-white with light borders
            {
                tags: { any: ["building"] },
                elements: "geometry.fill",
                stylers: [{ color: "#f3f3f5" }],
            },
            {
                tags: { any: ["building"] },
                elements: "geometry.outline",
                stylers: [{ color: "#e5e5eb" }],
            },
            // 5. Make roads bright white with light gray outlines
            {
                tags: { any: ["road", "road_network"] },
                elements: "geometry.fill",
                stylers: [{ color: "#ffffff" }],
            },
            {
                tags: { any: ["road", "road_network"] },
                elements: "geometry.outline",
                stylers: [{ color: "#eaeaed" }],
            },
            // 6. Style texts and labels to match the theme
            {
                tags: { any: ["road", "road_network"] },
                elements: "label.text.fill",
                stylers: [{ color: "#6e6e73" }],
            },
            {
                tags: { any: ["building"] },
                elements: "label.text.fill",
                // This ensures building/house numbers are clearly visible in a dark gray color
                stylers: [{ color: "#1c1c1e" }],
            },
        ];

        // Centering coordinates (Tbilisi: 41.674333, 44.875718)
        // IMPORTANT: Yandex Maps API v3 uses [longitude, latitude] coordinates order!
        const initialLocation = {
            center: [44.875718, 41.674333] as [number, number],
            zoom: 17,
        };

        const mapContainer = document.getElementById("map-container");
        if (!mapContainer) return;

        // Create the map instance
        const map = new YMap(mapContainer, {
            location: initialLocation,
            showScaleInCopyrights: true,
        });

        // Add the custom styled scheme layer
        const schemeLayer = new YMapDefaultSchemeLayer({
            theme: "light",
            customization: whiteSchemeCustomization,
        });
        map.addChild(schemeLayer);

        // Add standard features layer for overlays and markers
        const featuresLayer = new YMapDefaultFeaturesLayer({});
        map.addChild(featuresLayer);

        // Load and add standard Zoom control from UI theme package
        interface UIThemeModule {
            // eslint-disable-next-line @typescript-eslint/no-empty-object-type
            YMapZoomControl: new (
                props: Record<string, unknown>,
            ) => YMapEntity<unknown, {}>;
        }
        const { YMapZoomControl } = (await (
            ymaps3.import as (pkg: string) => Promise<unknown>
        )("@yandex/ymaps3-default-ui-theme")) as UIThemeModule;
        const zoomControl = new YMapControls({ position: "right" }).addChild(
            new YMapZoomControl({}),
        );
        map.addChild(zoomControl);

        // Set up Location Change Listener to update coordinates display dynamically
        const locationListener = new YMapListener({
            layer: "any",
            onUpdate: ({ location }) => {
                const center = location?.center;
                if (
                    center &&
                    typeof center[0] === "number" &&
                    typeof center[1] === "number"
                ) {
                    const coordDisplay =
                        document.getElementById("coord-display");
                    if (coordDisplay) {
                        // Coordinates shown as Latitude, Longitude
                        coordDisplay.textContent = `${center[1].toFixed(6)}, ${center[0].toFixed(6)}`;
                    }
                }
            },
        });
        map.addChild(locationListener);

        // Set up sidebar controls & events
        setupSidebarControls(map);

        // Fade out splash loader screen once everything is initialized
        const loader = document.getElementById("app-loader");
        if (loader) {
            loader.classList.add("fade-out");
        }
    } catch (error) {
        console.error("Failed to initialize Yandex Map:", error);
        const loaderSubtitle = document.querySelector(".loader-subtitle");
        if (loaderSubtitle) {
            loaderSubtitle.textContent = "შეცდომა რუკის ჩატვირთვისას.";
            (loaderSubtitle as HTMLElement).style.color = "#ff453a";
        }
    }
}

/**
 * Configures sidebar interactive elements (navigation buttons, search bar, add zone).
 */
function setupSidebarControls(map: YMap): void {
    // 1. Sector Buttons (Fast Navigation)
    const buttons = document.querySelectorAll(".sector-btn");
    buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
            buttons.forEach((b) => b.classList.remove("active"));
            btn.classList.add("active");

            const lat = parseFloat(btn.getAttribute("data-lat") || "0");
            const lng = parseFloat(btn.getAttribute("data-lng") || "0");
            const zoom = parseInt(btn.getAttribute("data-zoom") || "16");

            if (lat && lng) {
                // Smooth camera transition using setLocation
                map.setLocation({
                    center: [lng, lat],
                    zoom: zoom,
                    duration: 1000,
                });
            }
        });
    });

    // 2. Search Box parser (fly to coordinates if format matches "lat, lng")
    const searchInput = document.getElementById(
        "search-input",
    ) as HTMLInputElement;
    if (searchInput) {
        searchInput.addEventListener("keypress", (e) => {
            if (e.key === "Enter") {
                const query = searchInput.value.trim();
                // Match decimal coordinates format, e.g. "41.674333, 44.875718"
                const coordPattern = /^(-?\d+\.\d+)\s*,\s*(-?\d+\.\d+)$/;
                const match = query.match(coordPattern);

                if (match) {
                    const lat = parseFloat(match[1]);
                    const lng = parseFloat(match[2]);
                    map.setLocation({
                        center: [lng, lat],
                        zoom: 17,
                        duration: 1200,
                    });

                    // Update dynamic coordinates display immediately
                    const coordDisplay =
                        document.getElementById("coord-display");
                    if (coordDisplay) {
                        coordDisplay.textContent = `${lat.toFixed(6)}, ${lng.toFixed(6)}`;
                    }
                } else {
                    console.log(
                        `Searching for: ${query} (Geocoding not implemented)`,
                    );
                }
            }
        });
    }

    // 3. Add Territory button micro-interaction
    const addBtn = document.getElementById("add-territory-btn");
    if (addBtn) {
        addBtn.addEventListener("click", () => {
            const currentCenter = map.center;
            alert(
                `ახალი ზონის შექმნა კოორდინატებზე:\nLat: ${currentCenter[1].toFixed(6)}\nLng: ${currentCenter[0].toFixed(6)}`,
            );
        });
    }
}

// Kick off initialization
document.addEventListener("DOMContentLoaded", () => {
    initializeMap();
});
